{
  "name": "kipl-backend",
  "version": "1.0.0",
  "private": true,
  "description": "KIPL website server: renders published CMS content into the static pages and serves the /admin panel.",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "seed:content": "node scripts/build-seed.js",
    "seed:users": "node scripts/seed-users.js",
    "export:static": "node scripts/export-static.js",
    "optimize:images": "node scripts/optimize-images.js",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "express": "^4.22.3",
    "multer": "^1.4.4",
    "sharp": "^0.33.5"
  }
}
