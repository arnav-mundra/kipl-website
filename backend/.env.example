# Copy to backend/.env (never commit the real file).
PORT=4000
# Where the database, uploads and backups live (default: backend/data)
# KIPL_DATA_DIR=/var/lib/kipl
# Set when running behind a reverse proxy / load balancer so client IPs and HTTPS are detected
# TRUST_PROXY=true
# Public origin used in the static export
SITE_ORIGIN=https://kipl.co

# Initial admin passwords are NOT stored here. Pass them once when creating accounts:
#   KIPL_OWNER_PASSWORD=… KIPL_EDITOR_PASSWORD=… KIPL_HR_PASSWORD=… npm run seed:users
