{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "dist-site",
  "cleanUrls": true,
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . \":(exclude)media\"",
  "buildCommand": "cd backend && npm ci --omit=dev && node scripts/export-static.js --snapshot ../site-content --with-admin ../dist-site",
  "functions": {
    "api/server.js": {
      "includeFiles": "{frontend/**,backend/seed/**,site-content/content.json}",
      "maxDuration": 60
    }
  },
  "crons": [{ "path": "/api/cron", "schedule": "30 0 * * *" }],
  "redirects": [{ "source": "/admin", "destination": "/admin/", "permanent": true }],
  "rewrites": [
    { "source": "/api/admin/:path*", "destination": "/api/server?__original=/api/admin/:path*" },
    { "source": "/api/cron", "destination": "/api/server?__original=/api/cron" },
    { "source": "/preview/:path*", "destination": "/api/server?__original=/preview/:path*" },
    { "source": "/uploads/:path*", "destination": "/api/server?__original=/uploads/:path*" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
